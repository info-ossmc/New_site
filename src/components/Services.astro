---
import { services, company } from "../data/site";
---

<section id="services" class="py-[var(--spacing-section)]">
  <div class="container-x">
    <div class="max-w-2xl reveal">
      <p class="eyebrow mb-5">Specialist Chef Placement</p>
      <h2 class="text-[clamp(2rem,4.5vw,3.4rem)] font-light">
        Culinary talent for every facet of private life
      </h2>
      <p class="mt-5 text-[var(--color-slate)]">
        Whatever the setting — a principal residence, a yacht in the Mediterranean
        or a wellness-led household — we place chefs whose standard never wavers.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {services.map((s, i) => (
        <article
          class="group relative overflow-hidden bg-[var(--color-ink)] text-[var(--color-paper)] reveal"
          style={`transition-delay:${i * 90}ms`}
        >
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={s.image}
              alt={s.title}
              class="w-full h-full object-cover scale-100 group-hover:scale-105 transition-transform duration-700 ease-out opacity-90"
              loading="lazy"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-night)] via-[var(--color-night)]/30 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-8">
            <h3 class="text-2xl md:text-3xl font-light">{s.title}</h3>
            <p class="mt-3 text-[var(--color-light)] text-[15px] leading-relaxed max-w-md">
              {s.body}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 reveal">
      <a href="#contact" class="btn btn-dark">{company.cta}</a>
    </div>
  </div>
</section>
