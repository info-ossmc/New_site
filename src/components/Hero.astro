---
import { assets, company } from "../data/site";
---

<section id="top" class="relative min-h-[100svh] flex items-center">
  <div class="absolute inset-0 -z-10">
    <img
      src={assets.heroBg}
      alt="An elite private chef preparing fine cuisine in a luxury residence"
      class="w-full h-full object-cover"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, rgba(14,24,36,.55) 0%, rgba(14,24,36,.45) 40%, rgba(14,24,36,.75) 100%);"
    >
    </div>
  </div>

  <div class="container-x w-full text-[var(--color-paper)] pt-28 pb-20">
    <div class="max-w-3xl">
      <p class="eyebrow mb-6">{company.tagline}</p>
      <h1 class="text-[clamp(2.6rem,7vw,5.4rem)] leading-[1.02] font-light">
        Michelin-Trained Private Chefs,
        <span class="text-[var(--color-accent)]">Placed With Discretion.</span>
      </h1>
      <p class="mt-7 max-w-xl text-[var(--color-light)] text-lg leading-relaxed">
        Montclair Chef connects the world's most distinguished families with
        exceptional culinary talent — for estates, travel and the most private
        of occasions.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#contact" class="btn btn-accent">{company.cta}</a>
        <a href="#services" class="btn btn-light">Explore Our Services</a>
      </div>
    </div>
  </div>

  <a
    href="#partners"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-[var(--color-light)] flex flex-col items-center gap-2 text-[11px] tracking-[0.25em] uppercase opacity-80 hover:opacity-100 transition-opacity"
    aria-label="Scroll down"
  >
    <span>Scroll</span>
    <span class="block w-px h-10 bg-[var(--color-light)]/60"></span>
  </a>
</section>
