---
import { process } from "../data/site";
---

<section id="process" class="py-[var(--spacing-section)]">
  <div class="container-x">
    <div class="max-w-2xl reveal">
      <p class="eyebrow mb-5">The Montclair Process</p>
      <h2 class="text-[clamp(2rem,4.5vw,3.4rem)] font-light">
        Considered, confidential, complete
      </h2>
      <p class="mt-5 text-[var(--color-slate)]">
        From first conversation to long-term partnership, every step is handled
        with the precision and privacy our clients expect.
      </p>
    </div>

    <div class="mt-16 grid gap-px bg-black/10 sm:grid-cols-2 lg:grid-cols-4 border border-black/10">
      {process.map((p, i) => (
        <div
          class="bg-[var(--color-paper)] p-8 lg:p-9 reveal"
          style={`transition-delay:${i * 80}ms`}
        >
          <span class="font-display text-5xl font-light text-[var(--color-accent)]">{p.step}</span>
          <h3 class="mt-5 text-xl font-display font-light">{p.title}</h3>
          <p class="mt-3 text-[15px] text-[var(--color-slate)] leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
